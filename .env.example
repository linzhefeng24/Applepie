# Configuration precedence: exported environment > .env > config/defaults.json.
# Paths are relative to the project; no fixed checkout or user path is required.
# SERVICE_HOST=127.0.0.1
# FRONTEND_PORT=4173
# DEV_PORT=5173
# DATA_DIR=data
# SERVICE_STATE_DIR=data/services
# PG_BIN=/your/postgresql/bin
# PG_SHARE=/your/postgresql/share

# Each service HTTP port is configurable: CATALOG_PORT=8101, QUOTES_PORT=8110, etc.
# Complete default list: config/services.json and config/defaults.json.
# Calls to remote instances use CATALOG_URL=http://host:8101, DAILY_URL=..., etc.

# External independent PostgreSQL instances: configure ALL eight owners.
# MANAGE_POSTGRES=false
# CATALOG_DB_HOST=127.0.0.1
# CATALOG_DB_PORT=55441
# CATALOG_DB_NAME=aperture_catalog
# CATALOG_DB_USER=app_catalog
# CATALOG_DB_PASSWORD=your-own-secret
# Repeat DAILY, MINUTE, WATCHLIST, REPORTS, ACCOUNTS, SESSIONS, AUTHORIZATION_DB_*.

# HTTPS / remote deployment only:
# COOKIE_SECURE=true
# ALLOWED_ORIGINS=https://your-terminal.example
# CHROMIUM_PATH=/your/browser/executable
# APERTURE_PYPI_INDEX_URL=https://pypi.org/simple
# APERTURE_NPM_REGISTRY=https://registry.npmjs.org/
# APERTURE_VENV_DIR=/your/python/venv
