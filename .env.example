# Copy to .env and override only what you need. Environment variables take precedence.
# Relative filesystem paths resolve from the financial-terminal directory, never the caller's cwd.
# SERVICE_HOST=127.0.0.1
# MARKET_PORT=8101
# WATCHLIST_PORT=8102
# OPTIMIZATION_PORT=8103
# BACKTEST_PORT=8105
# HISTORY_PORT=8106
# STATISTICS_PORT=8107
# REPORTS_PORT=8108
# QUANT_PORT=8104
# FRONTEND_PORT=4173
# DEV_PORT=5173
# DB_PORT=55432
# DATA_DIR=data
# PG_DATA_DIR=data/pg

# Use an existing PostgreSQL server instead of a project-managed instance:
# MANAGE_POSTGRES=false
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=terminal
# DB_USER=your_user
# DB_PASSWORD=your_password

# Or select installed PostgreSQL binaries for a project-managed instance:
# PG_BIN=/your/postgresql/bin
# PG_SHARE=/your/postgresql/share
# CHROMIUM_PATH=/your/browser/executable

# Optional project-only Python mirror; HTTPS required, global pip config is ignored.
# APERTURE_PYPI_INDEX_URL=https://pypi.org/simple
# APERTURE_NPM_REGISTRY=https://registry.npmjs.org/

# Optional: override the managed Python environment location.
# APERTURE_VENV_DIR=/home/your-user/.cache/aperture/custom-venv
